<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration Data</title>
    
    <!-- Include jQuery Library -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --ink: #17251f;
            --forest: #173f35;
            --forest-light: #245949;
            --lime: #d5f36b;
            --canvas: #f3f5f0;
            --line: #dfe5dd;
            --muted: #66736c;
            --paper: #fff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-width: 320px;
            background: var(--canvas);
            color: var(--ink);
            font-family: 'DM Sans', 'Segoe UI', sans-serif;
        }

        button,
        input,
        select {
            font: inherit;
        }

        .shell {
            width: min(1160px, calc(100% - 48px));
            margin: 0 auto;
        }

        .hero {
            color: #f6f8f2;
            background-color: var(--forest);
            background-image: linear-gradient(90deg, transparent 49.9%, rgb(255 255 255 / 3%) 50%, transparent 50.1%);
            background-size: 72px 100%;
        }

        .hero-inner {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 24px;
            padding: 30px 0 34px;
        }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 14px;
            color: var(--lime);
            font-size: 0.73rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .brand-mark {
            width: 12px;
            height: 12px;
            background: var(--lime);
        }

        h1,
        h2,
        p {
            margin-top: 0;
        }

        h1 {
            margin-bottom: 0;
            font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
            font-size: 2.7rem;
            font-weight: 600;
            line-height: 1.05;
        }

        .hero-meta {
            margin: 0 0 3px;
            padding-left: 18px;
            border-left: 1px solid rgb(213 243 107 / 55%);
            color: #d0dbd3;
            font-size: 0.88rem;
        }

        .summary-strip {
            border-bottom: 1px solid var(--line);
            background: var(--paper);
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .stat {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 76px;
            padding: 14px 22px;
            border-right: 1px solid var(--line);
        }

        .stat:first-child {
            padding-left: 0;
        }

        .stat:last-child {
            padding-right: 0;
            border-right: 0;
        }

        .stat-label {
            color: var(--muted);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .stat strong {
            font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
            font-size: 1.45rem;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        main.shell {
            padding-top: 30px;
            padding-bottom: 56px;
        }

        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding-bottom: 22px;
            border-bottom: 1px solid var(--line);
        }

        .load-actions,
        .filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 9px;
        }

        button {
            min-height: 42px;
            padding: 0 16px;
            border: 1px solid transparent;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.88rem;
            font-weight: 700;
            transition: background-color 140ms ease, border-color 140ms ease, transform 140ms ease;
        }

        button:hover {
            transform: translateY(-1px);
        }

        button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid rgb(82 135 104 / 34%);
            outline-offset: 2px;
        }

        #btn-fetch {
            color: var(--forest);
            background: var(--lime);
        }

        #btn-fetch:hover {
            background: #c8e95b;
        }

        #btn-jquery {
            border-color: #bac9be;
            color: var(--forest);
            background: transparent;
        }

        #btn-jquery:hover {
            background: #e9eee8;
        }

        #student-search,
        #status-filter {
            min-height: 42px;
            border: 1px solid #cbd5cd;
            border-radius: 5px;
            background: var(--paper);
            color: var(--ink);
            font-size: 0.88rem;
        }

        #student-search {
            width: 240px;
            padding: 0 13px;
        }

        #status-filter {
            padding: 0 32px 0 12px;
        }

        .roster-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            padding: 24px 0 14px;
        }

        h2 {
            margin-bottom: 0;
            font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
            font-size: 1.35rem;
            font-weight: 600;
        }

        #result-count {
            margin: 0;
            color: var(--muted);
            font-size: 0.82rem;
            font-variant-numeric: tabular-nums;
        }

        #table-container {
            overflow-x: auto;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: var(--paper);
        }

        table {
            width: 100%;
            min-width: 760px;
            border-collapse: collapse;
            text-align: left;
        }

        th,
        td {
            padding: 15px 16px;
            border-bottom: 1px solid #e9ede8;
            white-space: nowrap;
        }

        th {
            color: #65736b;
            background: #f7f9f6;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        td {
            font-size: 0.87rem;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        tbody tr:hover {
            background: #f8faf6;
        }

        td.name-cell {
            font-weight: 700;
            text-transform: capitalize;
        }

        td.prn-cell {
            color: #506158;
            font-variant-numeric: tabular-nums;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 3px;
            font-size: 0.73rem;
            font-weight: 700;
        }

        .status-registered {
            color: #245b35;
            background: #e2f2df;
        }

        .status-pending {
            color: #79530b;
            background: #fff0cb;
        }

        .status-cancelled {
            color: #8d3c31;
            background: #fbe5df;
        }

        .empty-state {
            margin: 0;
            padding: 34px 20px;
            color: var(--muted);
            text-align: center;
            font-size: 0.9rem;
        }

        @media (max-width: 760px) {
            .shell {
                width: min(100% - 32px, 560px);
            }

            .hero-inner {
                align-items: start;
                flex-direction: column;
                gap: 16px;
                padding: 25px 0 28px;
            }

            h1 {
                font-size: 2.15rem;
            }

            .hero-meta {
                padding-left: 0;
                border-left: 0;
            }

            .stat {
                align-items: start;
                flex-direction: column-reverse;
                justify-content: center;
                gap: 2px;
                min-height: 68px;
                padding: 10px 12px;
            }

            .stat:first-child {
                padding-left: 0;
            }

            .stat-label {
                font-size: 0.59rem;
            }

            .stat strong {
                font-size: 1.2rem;
            }

            .toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .load-actions,
            .filters {
                width: 100%;
            }

            #student-search {
                flex: 1 1 170px;
                width: auto;
            }

            #status-filter {
                flex: 1 1 170px;
            }
        }

        @media (max-width: 420px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stat:nth-child(2) {
                border-right: 0;
            }

            .stat:nth-child(3),
            .stat:nth-child(4) {
                border-top: 1px solid var(--line);
            }

            .load-actions button {
                flex: 1;
                padding: 0 10px;
                font-size: 0.78rem;
            }

            .roster-heading {
                align-items: start;
                flex-direction: column;
                gap: 5px;
            }
        }
    </style>
</head>
<body>
    <header class="hero">
        <div class="shell hero-inner">
            <div>
                <p class="eyebrow"><span class="brand-mark" aria-hidden="true"></span> Campus events / student records</p>
                <h1>Student registrations</h1>
            </div>
            <p class="hero-meta">Event roster</p>
        </div>
    </header>

    <section class="summary-strip" aria-label="Registration summary">
        <div class="shell summary-grid">
            <div class="stat"><span class="stat-label">Total students</span><strong id="summary-total">0</strong></div>
            <div class="stat"><span class="stat-label">Registered</span><strong id="summary-registered">0</strong></div>
            <div class="stat"><span class="stat-label">Pending</span><strong id="summary-pending">0</strong></div>
            <div class="stat"><span class="stat-label">Cancelled</span><strong id="summary-cancelled">0</strong></div>
        </div>
    </section>

    <main class="shell">
        <section class="toolbar" aria-label="Roster controls">
            <div class="load-actions">
                <button id="btn-fetch" type="button">Load Student Data</button>
                <button id="btn-jquery" type="button">Load with $.getJSON()</button>
            </div>
            <div class="filters">
                <input id="student-search" type="search" placeholder="Search name or PRN" aria-label="Search by name or PRN">
                <select id="status-filter" aria-label="Filter by registration status">
                    <option value="">All statuses</option>
                    <option value="Registered">Registered</option>
                    <option value="Pending">Pending</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
        </section>

        <div class="roster-heading">
            <h2>Registration roster</h2>
            <p id="result-count">Roster not loaded</p>
        </div>
        <div id="table-container">
            <p class="empty-state">Roster not loaded</p>
        </div>
    </main>

    <script>
        const DATA_URL = 'students.json';
        const container = document.getElementById('table-container');
        const searchInput = document.getElementById('student-search');
        const statusFilter = document.getElementById('status-filter');
        const resultCount = document.getElementById('result-count');
        const columns = ['Name', 'PRN', 'Department', 'Year', 'Event Name', 'Registration Status'];
        let students = [];

        function updateSummary() {
            document.getElementById('summary-total').textContent = students.length;
            document.getElementById('summary-registered').textContent = students.filter(student => student['Registration Status'] === 'Registered').length;
            document.getElementById('summary-pending').textContent = students.filter(student => student['Registration Status'] === 'Pending').length;
            document.getElementById('summary-cancelled').textContent = students.filter(student => student['Registration Status'] === 'Cancelled').length;
        }

        function renderTable() {
            const searchTerm = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value;
            const visibleStudents = students.filter(student => {
                const matchesSearch = student.Name.toLowerCase().includes(searchTerm)
                    || student.PRN.toLowerCase().includes(searchTerm);
                const matchesStatus = !selectedStatus || student['Registration Status'] === selectedStatus;
                return matchesSearch && matchesStatus;
            });

            resultCount.textContent = students.length
                ? `${visibleStudents.length} of ${students.length} students`
                : 'Roster not loaded';

            if (visibleStudents.length === 0) {
                const emptyState = document.createElement('p');
                emptyState.className = 'empty-state';
                emptyState.textContent = students.length ? 'No students match these filters.' : 'No student records found.';
                container.replaceChildren(emptyState);
                return;
            }

            const table = document.createElement('table');
            const thead = table.createTHead();
            const headerRow = thead.insertRow();
            columns.forEach(column => {
                const header = document.createElement('th');
                header.scope = 'col';
                header.textContent = column;
                headerRow.appendChild(header);
            });

            const tbody = table.createTBody();
            visibleStudents.forEach(student => {
                const row = tbody.insertRow();
                columns.forEach(column => {
                    const cell = row.insertCell();
                    if (column === 'Name') cell.classList.add('name-cell');
                    if (column === 'PRN') cell.classList.add('prn-cell');
                    if (column === 'Registration Status') {
                        const badge = document.createElement('span');
                        badge.className = `status-badge status-${student[column].toLowerCase()}`;
                        badge.textContent = student[column];
                        cell.appendChild(badge);
                    } else {
                        cell.textContent = student[column];
                    }
                });
            });
            container.replaceChildren(table);
        }

        document.getElementById('btn-fetch').addEventListener('click', () => {
            container.innerHTML = '<p class="empty-state">Loading student records...</p>';

            fetch(DATA_URL)
                .then(response => {
                    if (!response.ok) throw new Error('Could not load student data.');
                    return response.json();
                })
                .then(data => {
                    students = data;
                    updateSummary();
                    renderTable();
                })
                .catch(error => {
                    const message = document.createElement('p');
                    message.className = 'empty-state';
                    message.textContent = `Error: ${error.message}`;
                    container.replaceChildren(message);
                });
        });

        document.getElementById('btn-jquery').addEventListener('click', () => {
            container.innerHTML = '<p class="empty-state">Loading student records...</p>';

            $.getJSON(DATA_URL, data => {
                students = data;
                updateSummary();
                renderTable();
            }).fail(() => {
                const message = document.createElement('p');
                message.className = 'empty-state';
                message.textContent = 'Error: Could not load student data.';
                container.replaceChildren(message);
            });
        });

        searchInput.addEventListener('input', renderTable);
        statusFilter.addEventListener('change', renderTable);
    </script>
</body>
</html>
