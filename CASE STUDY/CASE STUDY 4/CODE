<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Palindrome Checker Website</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #0f172a, #3b82f6);
      font-family: Arial, Helvetica, sans-serif;
      color: #f8fafc;
    }
    .container {
      width: min(92vw, 480px);
      background: rgba(15, 23, 42, 0.88);
      padding: 30px;
      border-radius: 24px;
      box-shadow: 0 20px 55px rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(255,255,255,0.1);
    }
    h1 {
      text-align: center;
      margin-top: 0;
    }
    label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
    }
    input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid #94a3b8;
      margin-bottom: 16px;
      font-size: 1rem;
    }
    button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      background: #22c55e;
      color: white;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { background: #16a34a; }
    .output {
      margin-top: 18px;
      padding: 16px;
      border-radius: 12px;
      background: rgba(148, 163, 184, 0.2);
      line-height: 1.6;
      min-height: 90px;
      white-space: pre-line;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Palindrome Checker (JANHAVI ADMANE PRN-24070521211)</h1>
    <label for="textInput">Enter a word or phrase</label>
    <input id="textInput" type="text" placeholder="Example: level, radar, or civic" />
    <button id="checkBtn">Check</button>
    <div id="output" class="output">Type something and click Check.</div>
  </div>

  <script>
    function checkPalindrome(text) {
      const cleaned = text.toLowerCase().replace(/[^a-z]/g, '');
      const reversed = cleaned.split('').reverse().join('');
      return {
        cleaned,
        reversed,
        isPalindrome: cleaned === reversed
      };
    }

    const textInput = document.getElementById('textInput');
    const checkBtn = document.getElementById('checkBtn');
    const output = document.getElementById('output');

    checkBtn.addEventListener('click', () => {
      const value = textInput.value.trim();

      if (!value) {
        output.textContent = 'Please enter some text first.';
        return;
      }

      const result = checkPalindrome(value);
      output.textContent = `Cleaned text: ${result.cleaned}\nReversed text: ${result.reversed}\n${result.isPalindrome ? '✅ It is a palindrome.' : '❌ It is not a palindrome.'}`;
    });
  </script>
</body>
</html>
